{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "rm -rf dist && cp -R vercel-static dist && node scripts/production-50off-cta-v1.mjs dist/index.html && node scripts/real-content-index-v1.mjs dist/index.html && node scripts/content-index-polish-v1.mjs dist/index.html && python3 --version",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/lingua-portuguesa",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/c%C3%B3pia-mapas-mentais-de-l%C3%ADngua-portug",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/mapas-gratuitos",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/mapas-gratuitos/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=60"
        }
      ]
    }
  ]
}
